---
import type { Estratagema } from "../lib/types";
import {
  CATEGORIAS,
  describirCodigo,
  teclas,
} from "../lib/estratagema-utils";

interface Props {
  estratagema: Estratagema;
}
const { estratagema: e } = Astro.props;
---

<li class="strat" data-categoria={e.categoria}>
  <img class="strat__image" src={e.imagen} alt="" loading="lazy" />
  <div class="strat__main">
    <h2>{e.nombre}</h2>
    <p class="strat__cat">{CATEGORIAS[e.categoria]}</p>
  </div>

  <div class="strat__code">
    <ol class="code" aria-label={`Código: ${describirCodigo(e.codigo)}`}>
      {teclas(e.codigo).map((t) => <li aria-hidden="true">{t.flecha}</li>)}
    </ol>
  </div>

</li>
