---
interface Props {
  page: number;
  totalPages: number;
  q: string;
}
const { page, totalPages, q } = Astro.props;

const href = (n: number) => {
  const params = new URLSearchParams();
  if (q) params.set("q", q);
  if (n > 1) params.set("page", String(n));
  const qs = params.toString();
  return qs ? `/?${qs}` : "/";
};
---

{
  totalPages > 1 && (
    <nav class="pagination" aria-label="Paginación">
      {page > 1 ? (
        <a href={href(page - 1)} rel="prev">Anterior</a>
      ) : (
        <span aria-disabled="true">Anterior</span>
      )}
      <p>Página {page} de {totalPages}</p>
      {page < totalPages ? (
        <a href={href(page + 1)} rel="next">Siguiente</a>
      ) : (
        <span aria-disabled="true">Siguiente</span>
      )}
    </nav>
  )
}
