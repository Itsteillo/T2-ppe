---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
---

<Layout title="Crear cuenta" description="Regístrate para agregar estratagemas al catálogo.">
  <section class="auth">
    <h1>Crear cuenta</h1>
    <form id="registro-form" class="form" novalidate>
      <label for="email">Correo electrónico</label>
      <input id="email" name="email" type="email" autocomplete="email" required />

      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" autocomplete="new-password" minlength="6" required />
      <p class="hint">Mínimo 6 caracteres.</p>

      <button type="submit" class="btn">Crear cuenta</button>
      <p id="form-msg" class="notice" role="status" hidden></p>
    </form>
    <p class="auth__alt">¿Ya tienes cuenta? <a href="/login">Iniciar sesión</a></p>
  </section>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";
  import { supabase } from "../lib/supabase";

  function init() {
    const form = document.querySelector<HTMLFormElement>("#registro-form");
    if (!form || form.dataset.ready) return;
    form.dataset.ready = "true";

    const msg = document.querySelector<HTMLElement>("#form-msg")!;
    const boton = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const datos = new FormData(form);
      const email = String(datos.get("email") ?? "").trim();
      const password = String(datos.get("password") ?? "");

      if (!email || password.length < 6) {
        mostrar(msg, "Escribe un correo válido y una contraseña de al menos 6 caracteres.", true);
        return;
      }

      boton.disabled = true;
      const { data, error } = await supabase.auth.signUp({ email, password });
      boton.disabled = false;

      if (error) {
        mostrar(msg, `No se pudo crear la cuenta: ${error.message}`, true);
        return;
      }
      if (data.session) {
        navigate("/admin");
        return;
      }
      // Con "Confirm email" activado, Supabase no abre sesión hasta confirmar el correo.
      mostrar(msg, "Cuenta creada. Revisa tu correo para confirmarla y luego inicia sesión.", false);
      form.reset();
    });
  }

  function mostrar(el: HTMLElement, texto: string, esError: boolean) {
    el.hidden = false;
    el.textContent = texto;
    el.classList.toggle("notice--error", esError);
  }

  document.addEventListener("astro:page-load", init);
</script>
