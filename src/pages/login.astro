---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
---

<Layout title="Iniciar sesión" description="Ingresa para administrar tus estratagemas.">
  <section class="auth">
    <h1>Iniciar sesión</h1>
    <form id="login-form" class="form" novalidate>
      <label for="email">Correo electrónico</label>
      <input id="email" name="email" type="email" autocomplete="email" required />

      <label for="password">Contraseña</label>
      <input id="password" name="password" type="password" autocomplete="current-password" required />

      <button type="submit" class="btn">Iniciar sesión</button>
      <p id="form-msg" class="notice" role="status" hidden></p>
    </form>
    <p class="auth__alt">¿No tienes cuenta? <a href="/registro">Crear cuenta</a></p>
  </section>
</Layout>

<script>
  import { navigate } from "astro:transitions/client";
  import { supabase } from "../lib/supabase";

  function init() {
    const form = document.querySelector<HTMLFormElement>("#login-form");
    if (!form || form.dataset.ready) return;
    form.dataset.ready = "true";

    const msg = document.querySelector<HTMLElement>("#form-msg")!;
    const boton = form.querySelector<HTMLButtonElement>("button[type=submit]")!;

    // Si ya hay sesión, no hace falta volver a entrar.
    supabase.auth.getSession().then(({ data }) => {
      if (data.session) navigate("/admin");
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const datos = new FormData(form);
      const email = String(datos.get("email") ?? "").trim();
      const password = String(datos.get("password") ?? "");

      if (!email || !password) {
        mostrar(msg, "Escribe tu correo y tu contraseña.", true);
        return;
      }

      boton.disabled = true;
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      boton.disabled = false;

      if (error) {
        mostrar(msg, "Correo o contraseña incorrectos.", true);
        return;
      }
      navigate("/admin");
    });
  }

  function mostrar(el: HTMLElement, texto: string, esError: boolean) {
    el.hidden = false;
    el.textContent = texto;
    el.classList.toggle("notice--error", esError);
  }

  document.addEventListener("astro:page-load", init);
</script>
